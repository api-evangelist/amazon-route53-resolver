              "raw": "{\n  \"Name\": \"B\",\n  \"DestinationArn\": \"<string>\",\n  \"CreatorRequestId\": \"<string>\",\n  \"Tags\": [\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\"\n    },\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\"\n    }\n  ]\n}",
